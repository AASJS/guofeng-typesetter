      "cssSnippet": ".grid-disc{--sp:8px;display:grid;grid-template-columns:repeat(12,1fr);gap:var(--sp)}.grid-disc>*{grid-column:span 12}.grid-disc .tight{margin-bottom:calc(var(--sp)*2)}.grid-disc .loose{margin-bottom:calc(var(--sp)*4)}",
