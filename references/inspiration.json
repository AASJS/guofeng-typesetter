    {
      "id": "cinematic-hero",
      "title": "电影感英雄区（Cinematic Hero）",
      "category": "trend",
      "source": "awwwards-2026",
      "designLanguage": "全幅高清照片/视频背景 + 其上超大朴素字体，氛围由图定、信息由字给，最简布局也最难忘。",
      "palette": {
