      "category": "trend",
      "source": "awwwards-2026",
      "designLanguage": "取自泥土、黏土、沙、石的低饱和色板，叠加 Pantone 2025 摩卡慕斯；柔和、精致、有触感。",
      "palette": {
        "bg": "#E8E4DF",
        "ink": "#3A352C",
        "accent": "#A47764"
      },
      "fonts": [
        "Cormorant Garamond",
        "Fraunces"
      ],
      "cssSnippet": ":root{--sand:#E8E4DF;--mocha:#A47764;--clay:#9C6B4A;--gold:#C5A572;--ink:#3A352C}",
      "applicableTo": [
        "sage",
        "single"
      ],
      "tags": [
        "earthy",
        "muted",
        "tactile"
      ],
      "note": "草木绿之外的高级自然色方案，适配中医/东方美学/自然疗愈内容。"
    },
